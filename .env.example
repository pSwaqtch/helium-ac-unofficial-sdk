# Copy to .env and fill in your device. `.env` is gitignored.
#
# Only HELIUM_DEVICE_MAC is required — it addresses your specific unit. The rest
# are vendor constants recovered by reverse engineering (PROTOCOL §7i) and are
# already correct for stock firmware; override only if yours differs.

# Required. Your AC's MAC, lowercase hex without separators.
# Find it in the hoags device list `macid` field (README → HTTP API), or from a
# BLE scan: `python ble/scan.py`.
HELIUM_DEVICE_MAC=

# Product model, appears in the MQTT topic path.
# HELIUM_DEVICE_MODEL=HELM0000015HMKP1

# Substring used to spot the AC during a BLE scan.
# Defaults to the last 4 hex chars of HELIUM_DEVICE_MAC.
# HELIUM_BLE_NAME_MATCH=

# Vendor constants.
# HELIUM_BLE_PASSKEY=1111
# HELIUM_P12_PASSWORD=1234

# Cloud endpoints.
# HELIUM_MQTT_HOST=a198fgj6igmrrt-ats.iot.ap-south-1.amazonaws.com
# HELIUM_MQTT_PORT=8883
# HELIUM_API_BASE=https://o7sbv8y912.execute-api.ap-south-1.amazonaws.com/dev
# HELIUM_HOAGS_BASE=https://tz1z01inlb.execute-api.ap-south-1.amazonaws.com/hoags

# Credential files extracted from the vendor APK (gitignored).
# HELIUM_P12_PATH=apk/assets/AWSiOT.p12
# HELIUM_CA_PATH=apk/assets/AmazonRootCA1.pem

# ---- Google Assistant via SinricPro (bridge/sinricpro_bridge.py) ----
# Create a free account at https://sinric.pro, add a device of type
# "Thermostat" named "AC", then copy its credentials here. See bridge/README.md.
SINRICPRO_APP_KEY=
SINRICPRO_APP_SECRET=
SINRICPRO_AC_DEVICE_ID=
